# Polar Configuration (legacy web billing; kept for existing Polar subscribers)
# Get these from https://polar.sh/dashboard

# Polar Access Token (required for Polar customer portal fallback)
# Create from: Organization Settings > Access Tokens
POLAR_ACCESS_TOKEN=polar_at_xxxxx

# Polar Server Environment
# Use "sandbox" for testing, "production" for live
POLAR_SERVER=sandbox

# Polar Webhook Secret (required for Polar webhooks)
# Get from: Organization Settings > Webhooks
POLAR_WEBHOOK_SECRET=polar_wh_xxxxx

# Dodo Payments (new web checkout). Set these in the Convex dashboard, not only .env:
# npx convex env set DODO_PAYMENTS_API_KEY your_api_key
# npx convex env set DODO_PAYMENTS_ENVIRONMENT test_mode
# npx convex env set DODO_PAYMENTS_WEBHOOK_SECRET your_webhook_secret
# Webhook URL: https://<CONVEX_SITE_URL>/dodopayments-webhook


# Site Configuration
SITE_URL=http://localhost:3004
NATIVE_APP_URL=feelchat://

# Web payments — defaults to disabled (App Store download modal). Set to false to enable Dodo checkout on web.
# NEXT_PUBLIC_DISABLE_WEB_PAYMENT=false

# Web login — defaults to disabled (App Store download modal). Set to false to restore web sign-in and chat.
# NEXT_PUBLIC_DISABLE_WEB_LOGIN=false

# Optional override for FeelChat App Store ID (default: 6768152855)
# NEXT_PUBLIC_IOS_APP_STORE_ID=6768152855

# Better-Auth Configuration
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
